# Copy to .env for Docker Compose. Never commit the real .env.
# Local HTTP only. Render sets APP_ENV=production and uses HTTPS.
APP_ENV=development
APP_PASSWORD=
SESSION_SECRET=
FRED_API_KEY=
TWELVE_DATA_API_KEY=
# Optional Twelve Data symbol overrides. Validate symbols/entitlements with your provider.
# Supported keys: sp500,nasdaq100,gold,wti,vix,dxy,us2y,us10y,usdcny,csi300,hsi
MARKET_SYMBOLS_JSON={}
ENABLE_SCHEDULER=true
